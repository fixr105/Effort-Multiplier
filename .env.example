# Copy this file to .env and fill in the values locally.
# Never commit .env. Do not paste the client secret into chat or source files.

# Zoho API Console → Server-based Applications → Client ID
ZOHO_CLIENT_ID=

# Zoho API Console → Client Secret
ZOHO_CLIENT_SECRET=

# Must match the redirect URI registered in the Zoho API Console exactly.
# Local development accepts only the localhost callback below.
# Production accepts only https://em.multiplierclub.in/api/integrations/zoho/callback
# The server sends this value unchanged and will not substitute a different URL.
ZOHO_REDIRECT_URI=http://localhost:5173/api/integrations/zoho/callback

# Optional durable Postgres URL. Required on Vercel. Leave empty for local SQLite.
DATABASE_URL=

# Google Cloud OAuth Web client. Leave empty until the client exists.
# Production redirect must be exactly:
# https://em.multiplierclub.in/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback

# Comma-separated product ids whose Google Cloud APIs an administrator has enabled.
# Products stay hidden until they are listed here. Chat, Admin SDK, and Workspace Events are ignored.
# Confirmed for the Effort Multiplier OAuth client:
GOOGLE_CONFIRMED_PRODUCTS=gmail,calendar,drive,docs,sheets,slides,forms,tasks,people,meet,analytics,search-console,apps-script

# 32-byte keys, hex-encoded (64 characters). Generate a different value for each:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
